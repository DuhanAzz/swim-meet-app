# 1. Matikan fitur intip folder
Options -Indexes

# [TAMBAHAN BARU] Beritahu Apache bahwa file utamanya ada di dalam public
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 2. Jika user hanya mengetik nama domain, langsung tembak ke public/index.php
    RewriteRule ^$ public/index.php [L]

    # 3. Izinkan pembacaan file asli (CSS, JS, Gambar) di dalam folder public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]

    # 4. Arahkan semua request URL sisanya ke gerbang utama
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>