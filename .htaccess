# 1. Matikan fitur intip folder
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 2. Beritahu Apache bahwa web ini ada di dalam folder swim-meet
    RewriteBase /swim-meet/

    # 3. Jika user HANYA mengetik localhost/swim-meet/ , tembak ke public/index.php
    RewriteRule ^$ public/index.php [L]

    # 4. [PENTING - PERBAIKAN] Jika file/folder yang diakses BENAR-BENAR ADA 
    # (Contoh: folder src/, file .php di dalamnya), biarkan dan JANGAN dialihkan!
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Jika file tidak ada (misal gambar/aset yang seharusnya ada di public), baru arahkan ke public/
    RewriteCond %{REQUEST_URI} !^/swim-meet/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>