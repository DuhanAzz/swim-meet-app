# 1. Matikan fitur intip folder
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 2. Jika request adalah root folder (kosong), arahkan ke public/index.php
    RewriteRule ^$ public/index.php [L]

    # 3. Jika file/folder yang diminta ADA secara fisik (misal: src/master/dashboard.php), langsung buka!
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
    RewriteRule ^ - [L]

    # 4. Jika file TIDAK ADA, asumsikan itu adalah file public (misal: /login.php -> /public/login.php)
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]

    # 5. Fallback: Jika setelah dicari di public/ tetap tidak ada, serahkan ke gerbang utama
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>