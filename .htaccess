# 1. Matikan fitur intip folder
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 2. [PENTING] Beritahu Apache bahwa web ini ada di dalam folder swim-meet
    RewriteBase /swim-meet/

    # 3. Jika user mengetik localhost/swim-meet/, tembak ke public/index.php
    RewriteRule ^$ public/index.php [L]

    # 4. Izinkan pembacaan file asli & Cegah Infinite Loop (Error 500)
    RewriteCond %{REQUEST_URI} !^/swim-meet/public/
    RewriteRule ^(.*)$ public/$1 [L]

    # 5. Arahkan semua request URL sisanya ke gerbang utama
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>